<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>apps</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <!-- Self-contained only when publishing for a specific RID (always the case for publish.sh / release.yml).
             Without a RID (e.g. a plain `dotnet build` or a test-project reference) the output stays
             framework-dependent so non-self-contained projects can reference it. -->
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <Product>apps</Product>
        <Description>macOS CLI tool that discovers installed applications, SDKs, runtimes, and developer tools and checks each one for available updates.</Description>
        <Authors>iamr8</Authors>
        <RepositoryUrl>https://github.com/iamr8/apps</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>../LICENSE</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/iamr8/apps</PackageProjectUrl>

        <VersionFull>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</VersionFull>
        <VersionPrefix>$(VersionFull.Split('-')[0])</VersionPrefix>
        <Version>$(VersionFull)</Version>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="apps.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
        <PackageReference Include="System.Threading.RateLimiting" Version="10.0.11" />
    </ItemGroup>

</Project>
